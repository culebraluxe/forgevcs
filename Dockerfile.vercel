# ForgeVCS service image — Vercel runs this as an HTTP server on Fluid compute.
#
# The filename matters: Vercel reads `Dockerfile.vercel` (or `Containerfile.vercel`)
# and nothing else. Everything inside is portable OCI — no Vercel APIs in play.
# The server must listen on $PORT, which Vercel injects; 3000 is our local default.

# syntax=docker/dockerfile:1

FROM rust:1.98-bookworm AS build
WORKDIR /src
ENV CARGO_TARGET_DIR=/target \
    CARGO_INCREMENTAL=0

COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
COPY upstream ./upstream

RUN cargo build --release --locked -p forgevcs-service

FROM debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /target/release/forgevcs-service /usr/local/bin/forgevcs-service
RUN useradd --system --uid 10001 forgevcs
USER forgevcs
ENV PORT=3000
EXPOSE 3000
ENTRYPOINT ["/usr/local/bin/forgevcs-service"]

